  'dwarf_bytesize.c',
  'dwarf_arrayorder.c',
  'dwarf_bitsize.c',
  'dwarf_bitoffset.c',
  'dwarf_srclang.c',
  'dwarf_getabbrevtag.c',
  'dwarf_getabbrevcode.c',
  'dwarf_abbrevhaschildren.c',
