  libdwfl_headers,
  libdwelf_headers,
  _eu_headers,
  install: true,
  include_directories: include_directories('../libebl', '../libelf', '../libdwelf'),
  link_whole: [
    libebl_lib,
    libebl_backends_lib,
    libcpu_lib,
    libdwelf_lib,
    libdwfl_lib,
    libeu_lib,
  ],
  link_with: [libelf_lib],
  dependencies: [
    dl_dep,
    zlib_dep,
    argp_dep,
    fts_dep,
    obstack_dep,
    lzma_dep,
    zstd_dep,
    threads_dep,
  ],
)
libdw_dep = declare_dependency(
  link_with: libdw_lib,
  include_directories: include_directories('.', '../libdwfl', '../libdwelf'),
  sources: [_eu_headers, libdwfl_headers, libdwelf_headers],
)
meson.override_dependency('libdw', libdw_dep)
