  'dwarf_attr_integrate.c',
  'dwarf_hasattr_integrate.c',
  'dwarf_child.c',
  'dwarf_haschildren.c',
  'dwarf_formaddr.c',
  'dwarf_formudata.c',
  'dwarf_formsdata.c',
  'dwarf_lowpc.c',
  'dwarf_entrypc.c',
  'dwarf_haspc.c',
  'dwarf_highpc.c',
  'dwarf_ranges.c',
  'dwarf_formref.c',
  'dwarf_formref_die.c',
  'dwarf_siblingof.c',
  'dwarf_dieoffset.c',
