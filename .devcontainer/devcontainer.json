{
  "capAdd": [
    "SYS_ADMIN",
    "PERFMON"
  ],
  "containerEnv": {
    "LANG": "${localEnv:LANG:C.UTF-8}",
    "OMPI_ALLOW_RUN_AS_ROOT": "1",
    "OMPI_ALLOW_RUN_AS_ROOT_CONFIRM": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "mesonbuild.mesonbuild"
      ],
      "settings": {
        "clangd.arguments": [
          "--compile-commands-dir=${config:mesonbuild.buildFolder}"
        ],
        "mesonbuild.buildFolder": "builddir",
        "mesonbuild.configureOnOpen": true
      }
    }
  },
  "image": "registry.gitlab.com/hpctoolkit/rtt-images:1.0.0-aio",
  "mounts": [
    {
      "source": "hpctoolkit-builddir-${devcontainerId}",
      "target": "${containerWorkspaceFolder}/builddir",
      "type": "volume"
    },
    {
      "source": "ccache-${devcontainerId}",
      "target": "/var/cache/ccache",
      "type": "volume"
    }
  ],
  "remoteEnv": {
    "CCACHE_DIR": "/var/cache/ccache"
  }
}
